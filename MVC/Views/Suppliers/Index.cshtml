@model IEnumerable<MVC.Models.Suppliers>

@{
    ViewData["Title"] = "Suppliers";
    var supplierList = Model?.ToList() ?? new List<MVC.Models.Suppliers>();
}

<!-- Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Partner Suppliers</h1>
        <p class="text-muted mb-0">Manage vendor contact persons, communication channels, and sourcing partners.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Add Supplier
        </a>
    </div>
</div>

<!-- Table Container & Toolbar -->
<div class="sg-table-container">
    <div class="sg-table-toolbar">
        <div class="sg-table-search">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" placeholder="Search by name, contact, email..." data-sg-table-search="suppliersTable" />
            <button type="button" class="clear-search" aria-label="Clear search">
                <i class="bi bi-x-circle-fill"></i>
            </button>
        </div>

        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm w-auto" data-sg-table-filter="suppliersTable" data-sg-filter-col="4">
                <option value="">All Statuses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-responsive">
        <table class="sg-table" id="suppliersTable">
            <thead>
                <tr>
                    <th>Supplier / Company</th>
                    <th>Contact Person</th>
                    <th>Contact Channels</th>
                    <th>Location</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!supplierList.Any())
                {
                    <tr class="no-records-row">
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-truck fs-1 d-block mb-2 opacity-50"></i>
                            <p class="mb-3">No suppliers found in directory.</p>
                            <a asp-action="Create" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-lg me-1"></i> Register First Supplier
                            </a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in supplierList)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sg-kpi-icon success" style="width: 36px; height: 36px; font-size: 1.05rem;">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <span class="fw-semibold text-dark">@item.SupplierName</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-dark">
                                    <i class="bi bi-person me-1 text-muted"></i>@item.ContactPerson
                                </span>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1 small">
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <a href="mailto:@item.Email" class="text-decoration-none text-muted">
                                            <i class="bi bi-envelope me-1 text-primary"></i>@item.Email
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Phone))
                                    {
                                        <a href="tel:@item.Phone" class="text-decoration-none text-muted">
                                            <i class="bi bi-telephone me-1 text-success"></i>@item.Phone
                                        </a>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(item.Address) ? "—" : item.Address)
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="sg-badge sg-badge-success">
                                        <span class="sg-badge-dot"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="sg-badge sg-badge-slate">
                                        <span class="sg-badge-dot"></span> Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Display" asp-route-supplierId="@item.SupplierId" class="btn btn-outline-secondary" title="View Supplier">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Update" asp-route-supplierId="@item.SupplierId" class="btn btn-outline-secondary" title="Edit Supplier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-supplierId="@item.SupplierId" class="btn btn-outline-danger" title="Delete Supplier">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Table Footer -->
    <div class="sg-table-pagination">
        <span data-sg-count-for="suppliersTable">
            Total @supplierList.Count suppliers in directory
        </span>
    </div>
</div>
