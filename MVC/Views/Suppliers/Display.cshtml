@model MVC.Models.Suppliers

@{
    ViewData["Title"] = "Supplier Details - " + Model.SupplierName;
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Supplier Profile</h1>
                <p class="text-muted mb-0">Partner vendor profile and contact points.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Directory
                </a>
                <a asp-action="Update" asp-route-supplierId="@Model.SupplierId" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
            </div>
        </div>

        <!-- Supplier Profile Card -->
        <div class="sg-card">
            <div class="sg-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="sg-kpi-icon success" style="width: 40px; height: 40px; font-size: 1.25rem;">
                        <i class="bi bi-building"></i>
                    </div>
                    <div>
                        <h2 class="sg-card-title mb-0">@Model.SupplierName</h2>
                        <small class="text-muted">Vendor ID: #@Model.SupplierId</small>
                    </div>
                </div>
                @if (Model.IsActive)
                {
                    <span class="sg-badge sg-badge-success">
                        <span class="sg-badge-dot"></span> Active Vendor
                    </span>
                }
                else
                {
                    <span class="sg-badge sg-badge-slate">
                        <span class="sg-badge-dot"></span> Inactive Vendor
                    </span>
                }
            </div>

            <div class="sg-card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block mb-1">Primary Contact</label>
                        <div class="fw-semibold text-dark fs-6">
                            <i class="bi bi-person me-1 text-primary"></i>
                            @Model.ContactPerson
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block mb-1">Business Email</label>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="text-primary text-decoration-none fw-semibold">
                                    <i class="bi bi-envelope me-1"></i>@Model.Email
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not specified</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block mb-1">Phone Number</label>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <a href="tel:@Model.Phone" class="text-dark text-decoration-none fw-semibold">
                                    <i class="bi bi-telephone me-1 text-success"></i>@Model.Phone
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not specified</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block mb-1">Created Date</label>
                        <div class="text-muted">
                            <i class="bi bi-calendar3 me-1"></i>
                            @Model.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small text-uppercase fw-semibold d-block mb-1">Address / Headquarters</label>
                        <div class="p-3 rounded-3 bg-light text-dark">
                            @(string.IsNullOrWhiteSpace(Model.Address) ? "No physical address provided." : Model.Address)
                        </div>
                    </div>
                </div>
            </div>

            <div class="sg-card-footer d-flex justify-content-between align-items-center">
                <span class="text-muted small">Updated: @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                <a asp-action="Delete" asp-route-supplierId="@Model.SupplierId" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete Supplier
                </a>
            </div>
        </div>
    </div>
</div>
