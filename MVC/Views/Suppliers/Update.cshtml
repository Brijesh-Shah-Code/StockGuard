@model MVC.Models.Suppliers

@{
    ViewData["Title"] = "Update Supplier";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Update Supplier</h1>
                <p class="text-muted mb-0">Modify vendor details for <strong>@Model.SupplierName</strong></p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Directory
            </a>
        </div>

        <!-- Form Card -->
        <div class="sg-card">
            <div class="sg-card-header">
                <h2 class="sg-card-title">
                    <i class="bi bi-pencil-square text-primary"></i>
                    <span>Edit Vendor (ID: #@Model.SupplierId)</span>
                </h2>
            </div>

            <div class="sg-card-body">
                <form asp-action="Update" method="post" novalidate>
                    <input type="hidden" asp-for="SupplierId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="sg-alert sg-alert-danger alert alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                            <div>@ViewBag.ErrorMessage</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SupplierName" class="form-label">Supplier / Company Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <input asp-for="SupplierName" class="form-control" required />
                            </div>
                            <span asp-validation-for="SupplierName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactPerson" class="form-label">Contact Person <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="ContactPerson" class="form-control" required />
                            </div>
                            <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Business Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" type="tel" class="form-control" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label">Facility / Mailing Address</label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="updateSupplierIsActiveSwitch" />
                        <label class="form-check-label fw-semibold" for="updateSupplierIsActiveSwitch">
                            Active Supplier (Available for product assignment)
                        </label>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Update Supplier
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
