@model MVC.Models.vm_Login

@{
    ViewData["Title"] = "Sign In";
}

<div class="mb-4 text-center">
    <h2 class="h4 fw-bold text-dark mb-1">Welcome Back</h2>
    <p class="text-muted small">Sign in with your credentials to manage your inventory</p>
</div>

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email Address</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input asp-for="Email" type="email" class="form-control" placeholder="name@company.com" autocomplete="email" required />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label asp-for="PasswordHash" class="form-label mb-0">Password</label>
        </div>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
            <input asp-for="PasswordHash" type="password" id="loginPasswordInput" class="form-control" placeholder="••••••••" autocomplete="current-password" required />
            <button class="btn btn-outline-secondary toggle-password-visibility" type="button" data-target="loginPasswordInput" aria-label="Toggle password visibility">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="PasswordHash" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to StockGuard
    </button>
</form>

<div class="text-center pt-2 border-top">
    <p class="small text-muted mb-0">
        Don't have an account?
        <a asp-controller="Auth" asp-action="Register" class="fw-semibold text-primary">Create Account</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
