@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var userRole = ViewBag.UserRole as string ?? User.FindFirst(ClaimTypes.Role)?.Value ?? Context.Session.GetString("Role") ?? "User";
    var userName = ViewBag.UserName as string ?? User.Identity?.Name ?? Context.Session.GetString("FullName") ?? "User";
    var userEmail = ViewBag.UserEmail as string ?? User.FindFirst(ClaimTypes.Email)?.Value ?? Context.Session.GetString("Email") ?? "";
    var isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockGuard</title>
    
    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Core Bootstrap & Custom Design System -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="sg-layout-wrapper">
        <!-- Mobile Sidebar Backdrop -->
        <div class="sg-sidebar-backdrop" id="sgSidebarBackdrop"></div>

        <!-- Sidebar Navigation -->
        <aside class="sg-sidebar" id="sgSidebar">
            <!-- Sidebar Brand -->
            <div class="sg-sidebar-brand">
                <div class="sg-brand-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h1 class="sg-brand-text">StockGuard</h1>
                </div>
                <span class="sg-brand-badge ms-auto">PRO</span>
            </div>

            <!-- Sidebar Navigation Links -->
            <nav class="sg-sidebar-nav">
                <div class="sg-nav-heading">Main Navigation</div>
                
                <a asp-controller="Home" asp-action="Index" 
                   class="sg-nav-link @(currentController == "Home" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="StockTransactions" asp-action="Index" 
                   class="sg-nav-link @(currentController == "StockTransactions" ? "active" : "")">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Stock Transactions</span>
                </a>

                @if (isAdmin)
                {
                    <div class="sg-nav-heading">Inventory & Catalog</div>

                    <a asp-controller="Products" asp-action="Index" 
                       class="sg-nav-link @(currentController == "Products" ? "active" : "")">
                        <i class="bi bi-box-seam-fill"></i>
                        <span>Products</span>
                    </a>

                    <a asp-controller="Categories" asp-action="Index" 
                       class="sg-nav-link @(currentController == "Categories" ? "active" : "")">
                        <i class="bi bi-tags-fill"></i>
                        <span>Categories</span>
                    </a>

                    <a asp-controller="Suppliers" asp-action="Index" 
                       class="sg-nav-link @(currentController == "Suppliers" ? "active" : "")">
                        <i class="bi bi-truck-front-fill"></i>
                        <span>Suppliers</span>
                    </a>
                }

                <div class="sg-nav-heading">System & Account</div>
                
                <a asp-controller="Auth" asp-action="Logout" class="sg-nav-link text-danger-emphasis">
                    <i class="bi bi-box-arrow-right text-danger"></i>
                    <span>Sign Out</span>
                </a>
            </nav>

            <!-- Sidebar User Preview -->
            <div class="sg-sidebar-footer">
                <div class="sg-user-preview">
                    <div class="sg-user-avatar">
                        @(string.IsNullOrWhiteSpace(userName) ? "U" : userName.Substring(0, 1).ToUpper())
                    </div>
                    <div class="sg-user-info">
                        <div class="sg-user-name">@userName</div>
                        <div class="sg-user-role">
                            <span class="badge @(isAdmin ? "bg-primary" : "bg-secondary") py-1 px-2">@userRole</span>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="sg-main-wrapper">
            <!-- Topbar Header -->
            <header class="sg-topbar">
                <div class="sg-topbar-left">
                    <button type="button" class="sg-sidebar-toggle" id="sgSidebarToggle" aria-label="Toggle navigation">
                        <i class="bi bi-list"></i>
                    </button>
                    
                    <ul class="sg-breadcrumb d-none d-sm-flex">
                        <li class="sg-breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">StockGuard</a>
                        </li>
                        <li class="sg-breadcrumb-separator">
                            <i class="bi bi-chevron-right"></i>
                        </li>
                        <li class="sg-breadcrumb-item @(currentAction == "Index" ? "active" : "")">
                            @(currentController == "Home" ? "Dashboard" : currentController)
                        </li>
                        @if (currentAction != "Index")
                        {
                            <li class="sg-breadcrumb-separator">
                                <i class="bi bi-chevron-right"></i>
                            </li>
                            <li class="sg-breadcrumb-item active">
                                @currentAction
                            </li>
                        }
                    </ul>
                </div>

                <div class="sg-topbar-right">
                    <div class="sg-status-indicator d-none d-md-inline-flex">
                        <span class="sg-status-dot"></span>
                        <span>Inventory Live</span>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1" 
                                type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            <span class="d-none d-sm-inline fw-semibold">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" aria-labelledby="userMenuDropdown">
                            <li class="dropdown-header">
                                <strong class="d-block text-dark">@userName</strong>
                                <small class="text-muted">@userEmail</small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <span class="dropdown-item-text small text-muted">
                                    Role: <span class="fw-bold text-dark">@userRole</span>
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger d-flex align-items-center gap-2" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Content Container -->
            <main class="sg-content">
                <!-- Global Alerts & Feedback Notifications -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="sg-alert sg-alert-success alert alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 flex-shrink-0 text-success"></i>
                        <div class="flex-grow-1">
                            <strong>Success!</strong> @TempData["SuccessMessage"]
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="sg-alert sg-alert-danger alert alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 text-danger"></i>
                        <div class="flex-grow-1">
                            <strong>Notice:</strong> @TempData["ErrorMessage"]
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="sg-footer">
                <div>
                    &copy; @DateTime.Now.Year <strong>StockGuard Enterprise</strong>. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-muted">Privacy Policy</a>
                    <span class="text-muted">v2.0</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
