@model MVC.Models.Categories

@{
    ViewData["Title"] = "Update Category";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Update Category</h1>
                <p class="text-muted mb-0">Modify category details for <strong>@Model.CategoryName</strong></p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <!-- Form Card -->
        <div class="sg-card">
            <div class="sg-card-header">
                <h2 class="sg-card-title">
                    <i class="bi bi-pencil-square text-primary"></i>
                    <span>Edit Category (ID: #@Model.CategoryId)</span>
                </h2>
            </div>

            <div class="sg-card-body">
                <form asp-action="Update" method="post" novalidate>
                    <input type="hidden" asp-for="CategoryId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="sg-alert sg-alert-danger alert alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                            <div>@ViewBag.ErrorMessage</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label">Category Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tag"></i></span>
                            <input asp-for="CategoryName" class="form-control" required />
                        </div>
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="updateCategoryIsActiveSwitch" />
                        <label class="form-check-label fw-semibold" for="updateCategoryIsActiveSwitch">
                            Active Category (Visible for product assignment)
                        </label>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Update Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
