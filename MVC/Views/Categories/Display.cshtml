@model MVC.Models.Categories

@{
    ViewData["Title"] = "Category Details - " + Model.CategoryName;
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Category Details</h1>
                <p class="text-muted mb-0">Overview of taxonomy group specifications.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
                <a asp-action="Update" asp-route-categoryId="@Model.CategoryId" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
            </div>
        </div>

        <!-- Detail Card -->
        <div class="sg-card">
            <div class="sg-card-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="sg-kpi-icon primary" style="width: 36px; height: 36px; font-size: 1.1rem;">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <h2 class="sg-card-title mb-0">@Model.CategoryName</h2>
                </div>
                @if (Model.IsActive)
                {
                    <span class="sg-badge sg-badge-success">
                        <span class="sg-badge-dot"></span> Active
                    </span>
                }
                else
                {
                    <span class="sg-badge sg-badge-slate">
                        <span class="sg-badge-dot"></span> Inactive
                    </span>
                }
            </div>

            <div class="sg-card-body">
                <div class="mb-4">
                    <label class="text-muted small text-uppercase fw-semibold d-block mb-1">Description</label>
                    <div class="p-3 rounded-3 bg-light text-dark">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided for this category." : Model.Description)
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block mb-1">Created At</label>
                        <div class="text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>
                            @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block mb-1">Last Updated</label>
                        <div class="text-muted small">
                            <i class="bi bi-clock me-1"></i>
                            @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                        </div>
                    </div>
                </div>
            </div>

            <div class="sg-card-footer d-flex justify-content-between align-items-center">
                <span class="text-muted small">Category ID: #@Model.CategoryId</span>
                <a asp-action="Delete" asp-route-categoryId="@Model.CategoryId" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete Category
                </a>
            </div>
        </div>
    </div>
</div>
