@model MVC.Models.Products

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <!-- Delete Confirmation Card -->
        <div class="sg-card border-danger-subtle">
            <div class="sg-card-header bg-danger-subtle text-danger border-danger-subtle">
                <h2 class="sg-card-title text-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Confirm Product Deletion</span>
                </h2>
            </div>

            <div class="sg-card-body">
                <div class="text-center my-3">
                    <span class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle mb-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-trash3-fill fs-2"></i>
                    </span>
                    <h3 class="h5 fw-bold text-dark mb-1">Are you sure you want to delete this product?</h3>
                    <p class="text-muted small">
                        This action cannot be undone. Products with existing stock transactions cannot be deleted to maintain audit integrity.
                    </p>
                </div>

                <!-- Product Summary Details -->
                <div class="p-3 rounded-3 bg-light border mb-4">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">SKU:</span>
                        <span class="sg-sku-pill">@Model.SKU</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Product Name:</span>
                        <span class="fw-semibold text-dark">@Model.ProductName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Category:</span>
                        <span>@(Model.CategoryName ?? "None")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Supplier:</span>
                        <span>@(Model.SupplierName ?? "None")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Current Stock:</span>
                        <span class="fw-bold">@Model.StockQuantity units</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Status:</span>
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="ProductId" />
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash-fill me-1"></i> Delete Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
