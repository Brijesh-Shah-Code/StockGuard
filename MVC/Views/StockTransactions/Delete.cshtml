@model MVC.Models.StockTransactions

@{
    ViewData["Title"] = "Reverse Stock Transaction";
    var isAdjustment = Model.TransactionType == "ADJUSTMENT";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <!-- Delete / Reversal Card -->
        <div class="sg-card @(isAdjustment ? "border-warning-subtle" : "border-danger-subtle")">
            <div class="sg-card-header @(isAdjustment ? "bg-warning-subtle text-warning-emphasis" : "bg-danger-subtle text-danger")">
                <h2 class="sg-card-title @(isAdjustment ? "text-warning-emphasis" : "text-danger")">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@(isAdjustment ? "Cannot Revert Adjustment" : "Confirm Transaction Reversal")</span>
                </h2>
            </div>

            <div class="sg-card-body">
                <div class="text-center my-3">
                    <span class="d-inline-flex align-items-center justify-content-center @(isAdjustment ? "bg-warning-subtle text-warning-emphasis" : "bg-danger-subtle text-danger") rounded-circle mb-3" style="width: 64px; height: 64px;">
                        <i class="bi @(isAdjustment ? "bi-slash-circle-fill" : "bi-arrow-counterclockwise") fs-2"></i>
                    </span>
                    <h3 class="h5 fw-bold text-dark mb-1">
                        @(isAdjustment ? "Inventory Adjustments cannot be deleted" : "Reverse this stock transaction?")
                    </h3>
                    <p class="text-muted small">
                        @if (isAdjustment)
                        {
                            <span>ADJUSTMENT transactions set a direct baseline count; previous stock levels cannot be deduced. To rectify an adjustment, please submit a new adjustment transaction.</span>
                        }
                        else
                        {
                            <span>Deleting this transaction will reverse its effect on product inventory (@(Model.TransactionType == "IN" ? "deducting" : "restoring") @Model.Quantity units).</span>
                        }
                    </p>
                </div>

                <div class="p-3 rounded-3 bg-light border mb-4">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Transaction ID:</span>
                        <span class="fw-mono fw-bold">#@Model.TransactionId</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Product:</span>
                        <div>
                            <span class="fw-semibold text-dark">@Model.ProductName</span>
                            <span class="sg-sku-pill ms-1">@Model.ProductSKU</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Type:</span>
                        <span class="badge @(Model.TransactionType == "IN" ? "bg-success" : Model.TransactionType == "OUT" ? "bg-danger" : "bg-warning text-dark")">
                            @Model.TransactionType
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small">Quantity:</span>
                        <span class="fw-bold fs-6">@Model.Quantity units</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Recorded Date:</span>
                        <span class="text-muted small">@Model.TransactionDate.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="TransactionId" />
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </a>
                        @if (!isAdjustment)
                        {
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Confirm & Reverse Stock
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
