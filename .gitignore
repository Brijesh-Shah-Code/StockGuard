## ==============================================================================
## StockGuard .gitignore (ASP.NET Core & Visual Studio)
## ==============================================================================

# Build & Compilation Results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
publish/

# Visual Studio / Roslyn
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.pidb
*.booproj
*.sln.docstates

# Visual Studio Code & JetBrains Rider
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.DotSettings.user

# Sensitive Environment Configurations & Local Secrets
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.Production.json
**/secrets.json
.env

# Package Caches
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# Node & Frontend dependencies (if applicable)
node_modules/

# OS-generated files
[Tt]humbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

